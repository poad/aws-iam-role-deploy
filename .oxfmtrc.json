{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",

  // Ported from eslint.config.ts (@stylistic rules)
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "proseWrap": "preserve",
  "endOfLine": "lf",
  "insertFinalNewline": true,

  // Ported from eslint.config.ts (import-x/order):
  // builtin, then sibling/parent (mingled), then index, then object (= rest)
  "sortImports": {
    "partitionByNewline": true,
    "newlinesBetween": false,
    "groups": ["builtin", ["sibling", "parent"], "index", "unknown"]
  }
}
